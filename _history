{"entries":[{"timestamp":1792825251872,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":24558,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":1531,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":212,"length1":39,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":239,"length1":79,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"test.ts","value":"// テストはここに来ます。このパッケージが拡張機能として使用されるときにはコンパイルされません。\n"},{"type":"added","filename":"main.py","value":"\n\n速度 = 0\n周期 = 0\n振動 = 0\n振動状態 = 0\n新状態 = 0\n前回反転時刻 = -1\n今 = 0\ny = 0\n前回Y = 0\n重力Y = 0\n名前Y = \"\"\n\n# 調整用パラメータ\n振動しきい値 = 150\n変化しきい値 = 40\n停止時間 = 150\n送信間隔 = 100\n\nradio.set_group(191)\n\n# A/Bの識別\nif input.button_is_pressed(Button.A):\n    名前Y = \"AY\"\n    basic.show_string(\"A\")\nelse:\n    名前Y = \"BY\"\n    basic.show_string(\"B\")\n\n重力Y = input.acceleration(Dimension.Y)\n前回Y = 重力Y\n最終変化時刻 = input.running_time()\n送信時刻 = input.running_time()\n\ndef on_forever():\n    global 今, y, 前回Y, 重力Y\n    global 振動, 振動状態, 新状態\n    global 前回反転時刻, 周期, 速度\n    global 最終変化時刻, 送信時刻\n\n    今 = input.running_time()\n    y = input.acceleration(Dimension.Y)\n\n    # 加速度の変化から振動停止を検出\n    if abs(y - 前回Y) >= 変化しきい値:\n        最終変化時刻 = 今\n    前回Y = y\n\n    # 重力成分を除去して振動を抽出\n    重力Y = 重力Y * 0.9 + y * 0.1\n    振動 = y - 重力Y\n\n    # 停止判定（150ms）\n    if 今 - 最終変化時刻 >= 停止時間:\n        速度 = 0\n        振動状態 = 0\n        前回反転時刻 = -1\n    else:\n        # 振動の正負を判定\n        新状態 = 振動状態\n        if 振動 > 振動しきい値:\n            新状態 = 1\n        elif 振動 < 0 - 振動しきい値:\n            新状態 = -1\n\n        # 半周期ごとに速度を更新\n        if 新状態 != 振動状態:\n            if 振動状態 != 0 and 前回反転時刻 >= 0:\n                周期 = 今 - 前回反転時刻\n                if 周期 >= 60 and 周期 <= 600:\n                    速度 = 10000 / 周期\n                    if 速度 > 100:\n                        速度 = 100\n\n            前回反転時刻 = 今\n            振動状態 = 新状態\n\n    # Y成分のみ100msごとに送信\n    if 今 - 送信時刻 >= 送信間隔:\n        radio.send_value(名前Y, Math.round(速度))\n        送信時刻 = 今\n\n    basic.pause(20)\n\nbasic.forever(on_forever)\n"}]}],"snapshots":[{"timestamp":1792825251871,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"musen_kasokudo_3\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1792825632585}